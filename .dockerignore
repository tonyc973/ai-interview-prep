# Never bake secrets or local state into the image.
.env
*.env
!.env.example
data/
*.db
*.sqlite*

# VCS / CI
.git/
.github/

# Python caches / venvs
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/

# Tooling caches
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# Tests + docs aren't needed in the runtime image
tests/
docs/
*.md
!README.md

# Editor / OS
.idea/
.vscode/
.DS_Store
