# ============================================================================
# AI Interview Prep — environment configuration
# Copy to `.env` and fill in real values. `.env` is gitignored.
# The app fails fast at startup listing any REQUIRED var that is missing.
# All variables are prefixed APP_ and parsed by app/config.py (pydantic-settings).
# ============================================================================

# --- REQUIRED secrets (app refuses to start without these) ---------------
# OpenAI API key used by the LLM gateway. Never commit a real key.
APP_OPENAI_API_KEY=sk-replace-me
# Secret used to sign NiceGUI server-side user storage. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_STORAGE_SECRET=replace-with-a-long-random-string-at-least-32-chars

# --- Database ------------------------------------------------------------
# SQLAlchemy async URL. Default is local SQLite (async driver).
# Postgres example: postgresql+asyncpg://user:pass@host:5432/interview
APP_DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# --- LLM configuration ---------------------------------------------------
APP_OPENAI_DEFAULT_MODEL=gpt-4o-mini
# Per-agent overrides (leave blank to use the default model):
APP_MODEL_ROLE_RESEARCHER=
APP_MODEL_QUESTION_ARCHITECT=
APP_MODEL_MOCK_INTERVIEWER=
APP_MODEL_EVALUATOR=
APP_OPENAI_REQUEST_TIMEOUT_S=60
APP_OPENAI_MAX_RETRIES=4

# --- Guardrails / cost caps ----------------------------------------------
# Hard cap on total LLM spend per interview session (USD).
APP_MAX_COST_PER_SESSION_USD=0.50
# Hard cap on total LLM spend per user per UTC day (USD).
APP_MAX_COST_PER_USER_PER_DAY_USD=5.00
# Max characters accepted for pasted job description / CV.
APP_MAX_JD_CHARS=20000
APP_MAX_CV_CHARS=20000
# Default number of questions in a live mock interview.
APP_INTERVIEW_DEFAULT_QUESTIONS=8

# --- Auth / security -----------------------------------------------------
APP_PASSWORD_MIN_LENGTH=12
APP_PASSWORD_MIN_ZXCVBN_SCORE=3
# Login throttling: lockout after this many consecutive failures, base seconds.
APP_LOGIN_MAX_FAILURES=5
APP_LOGIN_LOCKOUT_BASE_SECONDS=2
APP_LOGIN_LOCKOUT_MAX_SECONDS=900

# --- Runtime -------------------------------------------------------------
APP_ENV=development
APP_LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8080
# Comma-separated. Used only for logging/health context.
APP_BASE_URL=http://localhost:8080
